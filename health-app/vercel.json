{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/push-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "30 13 * * 0"
    }
  ]
}
