# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_MONTHLY_PRICE_ID=price_your-monthly-price-id
STRIPE_ANNUAL_PRICE_ID=price_your-annual-price-id
STRIPE_LIFETIME_PRICE_ID=price_your-lifetime-price-id

# Gemini Flash — camera photo scan feature (AI food identification)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key


# Google Play Billing (Android TWA — package com.getinshape.app)
# Base64-encoded service-account JSON with Play Developer API access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.getinshape.app
# Shared secret guarding the RTDN push endpoint (?secret=...)
PLAY_RTDN_SECRET=
# Play subscription product IDs (must match Play Console)
NEXT_PUBLIC_PLAY_PRODUCT_MONTHLY=pro_monthly
NEXT_PUBLIC_PLAY_PRODUCT_ANNUAL=pro_annual

# PostHog — product analytics (signup, onboarding, meal_logged, paywall, conversion)
# Get a free project key at https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push — meal reminders / streak-save nudges
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Vercel Cron job sends as Authorization: Bearer <secret>
CRON_SECRET=
