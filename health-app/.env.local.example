# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe — legacy web billing. Razorpay (below) replaced it for new web
# checkouts (Stripe barely supports India-domestic INR recurring under RBI
# mandate rules). Kept only for the webhook + billing portal to keep working
# for subscribers who signed up before the switch.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay — web billing (replaces Stripe for new checkouts)
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Signing secret set on the webhook config in the Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Recurring Plan IDs (create in Dashboard → Subscriptions → Plans)
RAZORPAY_MONTHLY_PLAN_ID=plan_your-monthly-plan-id
RAZORPAY_ANNUAL_PLAN_ID=plan_your-annual-plan-id

# Gemini Flash — camera photo scan feature (AI food identification)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key


# Google Play Billing (Android TWA — package com.getinshape.app)
# Base64-encoded service-account JSON with Play Developer API access
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.getinshape.app
# Shared secret guarding the RTDN push endpoint (?secret=...)
PLAY_RTDN_SECRET=
# Play subscription product IDs (must match Play Console)
NEXT_PUBLIC_PLAY_PRODUCT_MONTHLY=pro_monthly
NEXT_PUBLIC_PLAY_PRODUCT_ANNUAL=pro_annual

# PostHog — product analytics (signup, onboarding, meal_logged, paywall, conversion)
# Get a free project key at https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error monitoring (production only; inert until a DSN is set).
# Create a project at https://sentry.io/ and paste the DSN in both vars.
# Runtime capture only — no source-map upload, so no SENTRY_AUTH_TOKEN needed.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push — meal reminders / streak-save nudges
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Vercel Cron job sends as Authorization: Bearer <secret>
CRON_SECRET=
