# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# next-pwa build output. `npm run build` rewrites public/sw.js on every run —
# the precache manifest carries a fresh revision hash per file — so keeping it
# tracked meant every build left the working tree dirty and every diff carried
# a regenerated artifact nobody reviews. Vercel builds these on deploy; there
# is no path that serves them from git. (2026-07-31 P2-9 → 2026-09-03 P2-10.)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
